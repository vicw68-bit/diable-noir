{
  "rules": {
    "_ping": {
      ".read": false,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['t']) && newData.child('t').isNumber()"
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && $roomId.matches(/^(enfer|taverne|purgatoire|cave|abysses)$/)",
        ".validate": "newData.hasChildren(['players'])"
      }
    }
  }
}
